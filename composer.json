{
    "name": "krytenuk/doctrine-auth",
    "description": "Headless login, throttling and two factor authentication for Doctrine ORM users, with Mezzio integration",
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^2.20",
        "mezzio/mezzio-authentication": "^1.11",
        "mezzio/mezzio-session": "^1.15",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "authors": [
        {
            "name": "Garry Childs",
            "email": "info@freedomwebservices.net",
            "homepage": "https://www.freedomwebservices.net/laminas/fws-doctrine-auth"
        }
    ],
    "keywords": [
        "mezzio",
        "authentication",
        "two factor",
        "doctrine",
        "ORM",
        "freedom"
    ],
    "autoload": {
        "psr-4": {
            "FwsDoctrineAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FwsDoctrineAuthTest\\": "test/"
        }
    },
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/krytenuk/doctrine-auth",
    "extra": {
        "laminas": {
            "config-provider": "FwsDoctrineAuth\\ConfigProvider"
        }
    },
    "funding": [
        {
            "type": "other",
            "url": "https://www.freedomwebservices.net/laminas/fws-doctrine-auth#donate"
        }
    ],
    "require-dev": {
        "laminas/laminas-diactoros": "^3.5",
        "laminas/laminas-servicemanager": "^3.22",
        "laminas/laminas-stdlib": "^3.19",
        "phpunit/phpunit": "^11.5",
        "roave/psr-container-doctrine": "^4.2"
    },
    "suggest": {
        "krytenuk/doctrine-crypt": "To encrypt the identity, looked up through its blind index"
    }
}
