{
  "name": "krytenuk/doctrine-auth",
  "description": "Laminas module for authentication using Doctrine",
  "require": {
    "php": "^8.1",
    "symfony/console": "^5.4 || ^6.0",
    "doctrine/doctrine-orm-module": "^6.0",
    "laminas/laminas-mvc": "^3.3.0",
    "laminas/laminas-view": "^2.15",
    "laminas/laminas-mvc-i18n": "^1.3",
    "laminas/laminas-servicemanager": "^3.10",
    "laminas/laminas-form": "^3.0",
    "laminas/laminas-inputfilter": "^2.13",
    "laminas/laminas-validator": "^2.15",
    "laminas/laminas-eventmanager": "^3.4",
    "laminas/laminas-authentication": "^2.9",
    "laminas/laminas-permissions-acl": "^2.9",
    "laminas/laminas-session": "^2.12",
    "laminas/laminas-stdlib": "^3.6",
    "laminas/laminas-modulemanager": "^2.11",
    "laminas/laminas-router": "^3.5",
    "laminas/laminas-mail": "^2.15",
    "laminas/laminas-serializer": "^2.12",
    "endroid/qr-code": "^4.4",
    "pragmarx/google2fa": "^8.0",
    "laminas/laminas-crypt": "^3.10",
    "laminas/laminas-mvc-plugin-flashmessenger": "^1.9",
    "laminas/laminas-cli": "^1.10",
    "ext-gettext": "*",
    "ext-curl": "*",
    "laminas/laminas-navigation": "^2.19",
    "laminas/laminas-i18n-phone-number": "^1.2"
  },
  "authors": [
    {
      "name": "Garry Childs",
      "email": "info@freedomwebservices.net",
      "homepage": "https://www.freedomwebservices.net/laminas/fws-doctrine-auth"
    }
  ],
  "keywords": [
    "Laminas",
    "authentication",
    "doctrine",
    "ORM",
    "freedom"
  ],
  "autoload": {
    "psr-4": {
      "FwsDoctrineAuth\\": "src/"
    }
  },
  "autoload-dev": {
  "psr-4": {
    "FwsDoctrineAuthTest\\": "test/"
  }
},
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/krytenuk/fws-doctrine-auth",
  "extra": {
    "laminas": {
      "module": "FwsDoctrineAuth"
    }
  },
  "funding": [
    {
      "type": "other",
      "url": "https://www.freedomwebservices.net/laminas/fws-doctrine-auth#donate"
    }
  ],
  "require-dev": {
    "laminas/laminas-test": "^4.8",
    "phpunit/phpunit": "^10.3",
    "laminas/laminas-coding-standard": "^2.5"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "cs-check": "phpcs",
    "cs-fix": "phpcbf"
  }
}
